NEXT_PUBLIC_ALLOWED_CODES=29384,98154,28592,54309,76391

# Car data source:
#   local -> read car file + specs from public/data/cars.json (no backend needed)
#   api   -> fetch from the backend through /api/cars/[id] (uses API_URL and NEXT_PUBLIC_BACKEND_STORAGE_URL)
NEXT_PUBLIC_DATA_SOURCE=local

API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_BACKEND_STORAGE_URL=http://127.0.0.1:8000/storage/


# API_URL=https://admin.omidcity.com/api
# NEXT_PUBLIC_BACKEND_STORAGE_URL=https://admin.omidcity.com/storage/